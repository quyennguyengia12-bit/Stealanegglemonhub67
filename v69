-- 4. ITERATIVE SCANNER (FIXED COMPACTION, NO LEAK)
-- ==============================================================================
local function forEachDescendantIterative(root, callback, maxDepth)
    maxDepth = maxDepth or 12
    local queue = {{root, 0}}
    local head = 1
    local count = 0
    while head <= #queue do
        local item = queue[head]
        head = head + 1
        count = count + 1
        if count % 1500 == 0 then
            task_wait()
        end
        local node = item[1]
        local d = item[2]
        pcall(callback, node)
        if d < maxDepth then
            local children = node:GetChildren()
            for i = 1, #children do
                queue[#queue + 1] = {children[i], d + 1}
            end
        end
        if head > 4000 then
            local shift = head - 1
            local len = #queue
            local newQueue = {}
            for i = shift + 1, len do
                newQueue[i - shift] = queue[i]
                queue[i] = nil
            end
            queue = newQueue
            head = 1
        end
    end
end

