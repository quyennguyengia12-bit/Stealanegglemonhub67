local function WalkTo(pos, timeout)
    if not Hum or not HRP or not pos then return false end
    pcall(function() Hum:MoveTo(pos) end)
    local start = os_clock()
    local lastIssue = start
    local lastPos = HRP.Position
    local stuckAt = start
    local jumps = 0
    timeout = timeout or 30
    while os_clock() - start < timeout do
        if State.FarmMode == "off" then return false end
        if not HRP or not Hum or Hum.Health <= 0 then return false end
        NoteGoodPos()
        if RewindIfFell() then return false end
        if (HRP.Position - pos).Magnitude < 6 then return true end
        if (HRP.Position - lastPos).Magnitude < 0.5 then
            if os_clock() - stuckAt > 2 then
                jumps = jumps + 1
                pcall(function() Hum.Jump = true end)
                pcall(function() Hum:MoveTo(pos) end)
                stuckAt = os_clock()
                if jumps > 3 then return false end
            end
        else
            lastPos = HRP.Position
            stuckAt = os_clock()
        end
        if os_clock() - lastIssue > 2 then
            pcall(function() Hum:MoveTo(pos) end)
            lastIssue = os_clock()
        end
        task_wait(0.25)
    end
    return HRP and (HRP.Position - pos).Magnitude < 8
end

-- SAFE-TELE LOOP: arc height so we fly over terrain/void (fixes TELE HỤT kẹt địa hình)
local function StartTeleLoop()
    if teleConn then return end
    teleConn = RunService.Heartbeat:Connect(function(dt)
        if not teleActive or not teleTarget then return end
        if State.KickShield then teleActive = false; return end
        local root = HRP
        if not root or not root.Parent then teleActive = false; return end
        local cur = root.Position
        local dist = (teleTarget - cur).Magnitude
        if dist < 2 then teleActive = false; return end
        local step = math_min(dist, State.TeleSpeed * (dt or 0.016))
        local dir = (teleTarget - cur).Unit
        -- arc: higher when far, settle to target+2 when close
        local arcY = teleTarget.Y + 3 + math_min(40, dist * 0.10)
        local blend = math_clamp(dist / 60, 0, 1)
        local desiredY = (teleTarget.Y + 2) * (1 - blend) + arcY * blend
        local newPos = cur + dir * step
        newPos = Vector3_new(newPos.X, desiredY, newPos.Z)
        pcall(function() root.CFrame = CFrame_new(newPos) end)
    end)
end

-- ADAPTIVE TIMEOUT: derive from distance when not supplied
local function TeleTo(pos, timeout, force)
    if State.KickShield then return false end
    if not HRP or not pos then return false end
    if not timeout then
        local d = (HRP.Position - pos).Magnitude
        timeout = (d / math_max(State.TeleSpeed, 1)) + 6
    end
    StartTeleLoop()
    teleTarget = pos
    teleActive = true
    local start = os_clock()
    while teleActive and (os_clock() - start) < timeout do
        if not HRP or not HRP.Parent then teleActive = false; return false end
        if not force and State.FarmMode == "off" then teleActive = false; return false end
        if (HRP.Position - pos).Magnitude < 3 then teleActive = false; return true end
        task_wait(0.1)
    end
    teleActive = false
    return HRP ~= nil and (HRP.Position - pos).Magnitude < 6
end

local function SmartMove(pos, timeout)
    if not State.KickShield and (State.StealMode == "tele" or State.StealMode == "instant") then
        if TeleTo(pos, timeout, false) then return true end
    end
    return WalkTo(pos, timeout or 25)
end

