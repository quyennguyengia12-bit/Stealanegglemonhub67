    StatusFrame.LayoutOrder = 999
    local StatusLbl = mk("TextLabel", StatusFrame, { Size = UDim2_new(1, -6, 1, 0), Position = UDim2_new(0, 3, 0, 0), BackgroundTransparency = 1, Text = "🟢 Sẵn sàng", TextColor3 = Color3_fromRGB(140, 230, 150), Font = Enum.Font.GothamSemibold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true })
    SetStatus = function(m)
        if not State.ShowStatus then return end
        pcall(function() StatusLbl.Text = m end)
    end

    -- ===== FARM PAGE =====
    local pFarm = Pages.Farm
    heading(pFarm, "Auto Farm")
    infoCard(pFarm, "Hệ Thống Auto Cướp & Giao", "Cướp trứng gần nhất → về ổ → nộp. Chống kẹt, tự nhảy, tự quét ổ.")
    toggleCard(pFarm, "Bật Auto Cướp & Giao Trứng", "Tự động hoàn toàn: cướp → về ổ → giao", false, function(v)
        if v then State.FarmMode = "auto"; StartFarm(); Notify("info", "🚜 FARM", "Đang cướp & giao trứng!", 3)
        else State.FarmMode = "off" end
    end)
    toggleCard(pFarm, "Ghost Mode (tránh player)", "Dừng farm khi có người trong 10m", false, function(v) State.Ghost = v end)
    toggleCard(pFarm, "Speed Pulse (±10%)", "Dao động tốc độ nhẹ khó phát hiện", false, function(v)
        if State.KickShield and v then Notify("warn", "🛡 KICK SHIELD", "Tắt shield trước khi bật pulse!", 2); return end
        State.SpeedPulse = v
    end)
    toggleCard(pFarm, "🌀 Speed Cycle (anti-detect)", "Xen kẽ tốc độ cao/an toàn phá pattern", false, function(v) State.SpeedCycle = v end)
    toggleCard(pFarm, "🏃 Auto Flee (trốn truy đuổi)", "Tăng tốc khi đang cầm trứng", false, function(v) State.AutoFlee = v end)
    sliderCard(pFarm, "⏱ Chu kỳ nhanh (s)", "Giây giữ tốc độ cao (5-60)", 5, 60, State.CycleHigh, function(v) State.CycleHigh = v end)
    sliderCard(pFarm, "🛡 Chu kỳ an toàn (s)", "Giây hạ về tốc độ an toàn (3-30)", 3, 30, State.CycleSafe, function(v) State.CycleSafe = v end)
    local speedCtl = sliderCard(pFarm, "Speed đi bộ", "Tốc độ nhân vật (16-400), ghi đè mỗi frame", WALK_SPEED_MIN, WALK_SPEED_MAX, State.FarmSpeed, function(v)
        State.FarmSpeed = v
        ApplySpeedNow()
    end)
    sliderCard(pFarm, "Bán kính quét", "Phạm vi tìm trứng (500-3000)", 500, 3000, State.Radius, function(v) State.Radius = v end)
    local srow = rowHalf(pFarm)
    buttonCard(srow, "➕ +50 Speed", function() speedCtl.set(State.FarmSpeed + 50); Notify("info", "🚶 SPEED", "WalkSpeed = " .. State.FarmSpeed, 2) end, Color3_fromRGB(60, 130, 90), true)
    buttonCard(srow, "➖ -50 Speed", function() speedCtl.set(State.FarmSpeed - 50); Notify("info", "🚶 SPEED", "WalkSpeed = " .. State.FarmSpeed, 2) end, Color3_fromRGB(125, 65, 65), true)

    -- ===== MODE PAGE =====
    local pMode = Pages.Mode
    heading(pMode, "Steal Mode")
    infoCard(pMode, "Chế Độ Cướp (Miranda-style)", "Walk an toàn • Teleguiado mượt • Instant tức thì.")
    local modeLabel = mk("TextLabel", pMode, { Size = UDim2_new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "Mode: 🚶 Walk (an toàn)", TextColor3 = SUB, Font = Enum.Font.GothamSemibold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left })
    local function SetMode(m)
        if State.KickShield and m ~= "walk" then Notify("warn", "🛡 KICK SHIELD", "Tắt shield trước khi đổi mode!", 3); return end
        State.StealMode = m
        teleActive = false
        local pretty = "🚶 Walk"
        if m == "tele" then pretty = "🌀 Teleguiado" elseif m == "instant" then pretty = "⚡ Instant Steal" end
        modeLabel.Text = "Mode: " .. pretty
        Notify("info", "🎛 MODE", pretty .. " - dùng Mode Actions để test!", 3)
    end
    local mrow = rowHalf(pMode)
    buttonCard(mrow, "🚶 Walk", function() SetMode("walk") end, Color3_fromRGB(45, 95, 185), true)
    buttonCard(mrow, "🌀 Teleguiado", function() SetMode("tele") end, Color3_fromRGB(120, 80, 180), true)
    local mrow2 = rowHalf(pMode)
    buttonCard(mrow2, "⚡ Instant", function() SetMode("instant") end, Color3_fromRGB(180, 60, 60), true)
    buttonCard(mrow2, "🔍 Find Instant Area", function()
        local z = FindInstantZone()
        if z then State.InstantZone = z; Notify("success", "📍 FOUND", "Đã chốt vùng Instant Steal!", 3)
        else Notify("warn", "📍 NOT FOUND", "Không thấy vùng Instant Steal", 2) end
    end, Color3_fromRGB(90, 90, 140), true)
    toggleCard(pMode, "Stand in Instant Area", "Đứng trong vùng instant trước khi cướp", false, function(v) State.UseInstantZone = v end)
    local teleCtl = sliderCard(pMode, "Tele Speed (tween)", "Tốc độ tele/tween (20-275)", TELE_SPEED_MIN, TELE_SPEED_MAX, State.TeleSpeed, function(v) State.TeleSpeed = v end)
    local trow = rowHalf(pMode)
    buttonCard(trow, "➕ +25 Tele", function() teleCtl.set(State.TeleSpeed + 25); Notify("info", "🌀 TELE", "TeleSpeed = " .. State.TeleSpeed, 2) end, Color3_fromRGB(60, 130, 90), true)
    buttonCard(trow, "➖ -25 Tele", function() teleCtl.set(State.TeleSpeed - 25); Notify("info", "🌀 TELE", "TeleSpeed = " .. State.TeleSpeed, 2) end, Color3_fromRGB(125, 65, 65), true)
    heading(pMode, "Mode Actions")
    buttonCard(pMode, "🌀 Tele + Cướp trứng gần nhất", ActionTeleSteal, Color3_fromRGB(120, 80, 180))
    buttonCard(pMode, "🏠 Tele về ổ / vùng an toàn", ActionTeleToNest, Color3_fromRGB(45, 95, 185))
    buttonCard(pMode, "⚡ Instant Steal gần nhất", ActionInstantSteal, Color3_fromRGB(180, 60, 60))

    -- ===== ZONE PAGE =====
    local pZone = Pages.Zone
    heading(pZone, "Dịch Chuyển Zone")
    infoCard(pZone, "Teleport nhanh giữa các vùng", "Quét nhãn zone rồi tele thích ứng (SafeTele hình cung).")
    buttonCard(pZone, "🔍 Quét lại zone", function()
        ScanZones()
        Notify("success", "🗺 ĐÃ QUÉT", "Tìm thấy " .. CountZones() .. " zone", 3)
    end, Color3_fromRGB(90, 90, 140))
    for _, zn in ipairs(ZONE_NAMES) do
        buttonCard(pZone, "🗺 " .. zn, function() TeleportToZone(zn) end, Color3_fromRGB(45, 95, 185))
    end

    -- ===== NEST PAGE =====
    local pNest = Pages.Nest
    heading(pNest, "Ổ Trứng")
    infoCard(pNest, "Quản Lý Ổ", "Lưu ổ giao / ổ lấy để farm di chuyển chính xác.")
    buttonCard(pNest, "🏠 Lưu Ổ Giao (đứng vùng an toàn)", function() SaveSafeNest(); Notify("success", "🏠 ĐÃ LƯU", "Ổ giao đã chốt!", 3) end, Color3_fromRGB(45, 95, 185))
    buttonCard(pNest, "🧹 Xóa Ổ Giao", function() State.SafeNest = nil; Notify("info", "🧹", "Đã xóa ổ giao", 2) end, Color3_fromRGB(125, 55, 55))
    buttonCard(pNest, "🥚 Lưu Ổ Lấy", function() SaveSpawnNest(); Notify("success", "🥚 ĐÃ LƯU", "Ổ lấy đã chốt!", 3) end, Color3_fromRGB(185, 135, 45))
    buttonCard(pNest, "🧹 Xóa Ổ Lấy", function() State.SpawnNest = nil; Notify("info", "🧹", "Đã xóa ổ lấy", 2) end, Color3_fromRGB(125, 55, 55))

    -- ===== VIEW PAGE =====
    local pView = Pages.View
    heading(pView, "Hiển Thị")
    toggleCard(pView, "Hiện Notify", "Bật/tắt toast góc phải màn hình", true, function(v) State.ShowNotify = v end)
    toggleCard(pView, "Hiện Status", "Dòng trạng thái farm cuối sidebar", true, function(v)
        State.ShowStatus = v
        StatusFrame.Visible = v
    end)
    toggleCard(pView, "Blur nền khi mở menu", "Làm mờ game khi cửa sổ mở", false, function(v) State.BlurOn = v; applyBlur() end)
    toggleCard(pView, "Hiển thị nút float 🍋", "Nút tròn mở/đóng cửa sổ", true, function(v) State.ShowFloat = v; FloatBtn.Visible = v end)
    toggleCard(pView, "🥚 ESP Trứng", "Highlight trứng có thể cướp", false, function(v)
        State.EspEggs = v
        if not v then ClearEggEsp() end
    end)
    toggleCard(pView, "👤 ESP Người chơi", "Highlight player khác xuyên tường", false, function(v)
        State.EspPlayers = v
        if not v then ClearPlayerEsp() end
    end)

    -- ===== SET PAGE =====
    local pSet = Pages.Set
    heading(pSet, "Cài Đặt")
    infoCard(pSet, "🍋 LEMON HUB " .. VERSION, "Premium: ESP + Zone Tele + Auto Flee + SafeTele.")
    local statCard = card(pSet, 70)
    local eggStolenLbl = mk("TextLabel", statCard, { Size = UDim2_new(0.5, -12, 0, 18), Position = UDim2_new(0, 12, 0, 8), BackgroundTransparency = 1, Text = "🥚 Cướp: 0", TextColor3 = TXT, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
    local eggPlacedLbl = mk("TextLabel", statCard, { Size = UDim2_new(0.5, -12, 0, 18), Position = UDim2_new(0.5, 0, 0, 8), BackgroundTransparency = 1, Text = "🏠 Giao: 0", TextColor3 = TXT, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
    local rateLbl = mk("TextLabel", statCard, { Size = UDim2_new(1, -24, 0, 16), Position = UDim2_new(0, 12, 0, 30), BackgroundTransparency = 1, Text = "⏱ 0.0 trứng/phút", TextColor3 = SUB, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left })
    toggleCard(pSet, "🔁 Auto Rejoin khi bị kick", "Tự vào lại server khi bị đuổi", true, function(v) State.AutoRejoin = v end)
    toggleCard(pSet, "😴 Anti-AFK (VirtualUser)", "Chống đá AFK; rủi ro, mặc định tắt", false, function(v) State.AntiAFK = v; SetAntiAFK(v) end)
    buttonCard(pSet, "🛡 Bật Kick Shield (chế độ an toàn)", ApplyKickShield, Color3_fromRGB(60, 160, 90))
    buttonCard(pSet, "🕵️ Quét script ngoại lai", function()
        local conflicts = DetectConflictingScripts()
        if #conflicts > 0 then Notify("warn", "🕵️ TÌM THẤY", table.concat(conflicts, ", ") .. " - tắt auto-execute!", 6)
        else Notify("success", "🕵️ SẠCH", "Không phát hiện script ngoại lai!", 3) end
    end, Color3_fromRGB(90, 90, 140))
    buttonCard(pSet, "🗑 Hủy script", function()
        scriptAlive = false
        State.FarmMode = "off"
        teleActive = false
        SetAntiAFK(false)
        ClearEggEsp()
        ClearPlayerEsp()
        pcall(function() Gui:Destroy() end)
    end, Color3_fromRGB(145, 30, 30))

    -- realtime stats updater
    task_spawn(function()
        while scriptAlive and Gui and Gui.Parent do
            task_wait(1)
            pcall(function()
                if eggStolenLbl then eggStolenLbl.Text = "🥚 Cướp: " .. State.EggsStolen end
                if eggPlacedLbl then eggPlacedLbl.Text = "🏠 Giao: " .. State.EggsPlaced end
                if rateLbl then
                    local elapsedMin = (os_clock() - State.SessionStart) / 60
                    local rate = elapsedMin > 0 and (State.EggsPlaced / elapsedMin) or 0
                    rateLbl.Text = string_format("⏱ %.1f trứng/phút", rate)
                end
            end)
        end
    end)

    task_spawn(function()
        while scriptAlive do
            task_wait(2)
            if Gui and not Gui.Parent then SafeParent(Gui) end
        end
    end)

    switchTab("Farm")
    Notify("success", "🍋 LEMON HUB " .. VERSION, "Premium - bản MỚI đầy đủ!", 5)
    local conflicts = DetectConflictingScripts()
    if #conflicts > 0 then
        Notify("warn", "🕵️ SCRIPT NGOẠI LAI", table.concat(conflicts, ", ") .. " - tắt auto-execute!", 6)
    end
    Log(LOG_LEVEL.INFO, "UI OK - bấm 🍋 để mở cửa sổ")
end

