Log(LOG_LEVEL.INFO, "Booting UI...")
local bootOk = false
for attempt = 1, 3 do
    local ok, err = pcall(BuildUI)
    if ok then
        bootOk = true
        break
    else
        Log(LOG_LEVEL.ERROR, "BOOT ERR #" .. attempt .. ": " .. tostring(err))
        showFatal(tostring(err))
        task_wait(1)
    end
end
