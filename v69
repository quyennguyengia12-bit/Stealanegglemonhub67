                        else
                            State.DeliverFails = State.DeliverFails + 1
                            SetStatus("⚠️ Chưa giao x" .. State.DeliverFails)
                            if State.DeliverFails >= 3 then
                                if src == "nest" then State.SafeNest = nil end
                                State.DeliverFails = 0
                            end
                        end
                        HumanPause()
                    end
                else
                    if State.Ghost and PlayerNearby(10) then task_wait(2) return end
                    if State.StealMode == "instant" and State.UseInstantZone and State.InstantZone and not State.KickShield then
                        if (HRP.Position - State.InstantZone).Magnitude > 8 then
                            SmartMove(State.InstantZone, 10)
                            task_wait(0.3)
                        end
                    end
                    local now = os_clock()
                    local best, bestDist = nil, math_huge
                    local cache = State.Cache.Steal
                    for i = 1, #cache do
                        local d = cache[i]
                        if d.p and d.p.Parent and d.pos and d.pos.Y > -20 and not (SkipMap[d.p] and now < SkipMap[d.p]) then
                            local dist = (HRP.Position - d.pos).Magnitude
                            if dist < State.Radius and dist < bestDist then bestDist, best = dist, d end
                        end
                    end
                    if best then
                        SetStatus(string_format("🚶 Tới trứng (%dm)", math_floor(bestDist)))
                        if SmartMove(best.pos, 25) then
                            task_wait(math_random(3, 8) / 10)
                            if TrySteal(best.p, best.pos) then
                                AssumeCarryUntil = os_clock() + 45
                                State.EggsStolen = State.EggsStolen + 1
                                SetStatus("✅ Cướp #" .. State.EggsStolen)
                                NotifyRef("success", "🥚 CƯỚP OK!", "Tổng: " .. State.EggsStolen, 3)
                            else
                                SkipMap[best.p] = os_clock() + 10
                                SetStatus("⚠️ Hụt, đổi mục tiêu...")
                            end
                            HumanPause()
                        else
                            SkipMap[best.p] = os_clock() + 25
                            SetStatus("⚠️ Kẹt đường, đổi trứng...")
                        end
                    else
                        SetStatus("⏳ Quét lại trứng...")
                        MaybeScan(true)
                        task_wait(2.5)
                    end
                end
            end)
            if not ok then Log(LOG_LEVEL.ERROR, "FARM ERR: " .. tostring(err)) end
            task_wait(0.2)
        end
        State.FarmRunning = false
        teleActive = false
        SetStatus("🟢 Sẵn sàng")
    end)
end

