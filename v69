            if obj:IsA("ProximityPrompt") and obj.Enabled then
                local text = string_format("%s %s %s", obj.ActionText or "", obj.ObjectText or "", obj.Name)
                local pos = PromptPos(obj)
                if pos then
                    local lowText = string_lower(text)
                    local isPlace = false
                    for i = 1, #EXPLICIT_PLACE do
                        if string_find(lowText, EXPLICIT_PLACE[i], 1, true) then isPlace = true; break end
                    end
                    if not isPlace and hasKW(text, PLACE_KW) and not hasKW(text, STEAL_KW) then isPlace = true end
                    if isPlace then
                        table_insert(State.Cache.Place, { p = obj, pos = pos })
                    elseif hasKW(text, STEAL_KW) then
                        table_insert(State.Cache.Steal, { p = obj, pos = pos })
                    end
                end
            end
        end, 8)
    end)
end

local function UpdateCache()
    State.Cache.Steal, State.Cache.Place = {}, {}
    ScanInto(Workspace)
end

local function PruneSkip()
    local now = os_clock()
    for k, v in pairs(SkipMap) do
        local alive = true
        pcall(function() alive = (k.Parent ~= nil) end)
        if v < now or not alive then SkipMap[k] = nil end
    end
end

local function GetAdaptiveScanInterval()
    local total = #State.Cache.Steal + #State.Cache.Place
    if total >= 10 then return 8
    elseif total < 3 then return 2
    else return 5 end
end

local function MaybeScan(force)
    if force or os_clock() - LastScan > GetAdaptiveScanInterval() then
        LastScan = os_clock()
        PruneSkip()
        UpdateCache()
    end
end

