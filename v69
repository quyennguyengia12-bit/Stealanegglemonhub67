local CARRY_BL = { "giao dịch", "trade", "cửa hàng", "shop", "mục lục", "nhiệm vụ", "quest", "trứng trộm cắp", "steal egg", "esp trứng", "lưu ổ", "xóa ổ", "thống kê", "hủy script", "place egg" }

local function IsCarrying()
    if os_clock() < AssumeCarryUntil then CarrySrc = "giả lập cầm"; return true end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        local found = false
        forEachDescendantIterative(pg, function(g)
            if found then return end
            if (g:IsA("TextButton") or g:IsA("TextLabel")) and g.Visible then
                local t = string_lower(tostring(g.Text))
                if string_find(t, "place egg", 1, true) then return end
                if string_find(t, "thả", 1, true) and not string_find(t, "thả tim", 1, true) and g.AbsoluteSize.Y > 20 and g.AbsoluteSize.Y < 200 then
                    CarrySrc = "nút GUI"; found = true; return
                end
                if string_find(t, "chạy!!", 1, true) then CarrySrc = "banner CHẠY"; found = true; return end
                if g.AbsoluteSize.Y > 5 and g.AbsoluteSize.Y < 150 then
                    local bl = false
                    for i = 1, #CARRY_BL do
                        if string_find(t, CARRY_BL[i], 1, true) then bl = true; break end
                    end
                    if not bl then
                        local kw = { "thả trứng", "drop egg", "đặt trứng", "deliver egg", "giao trứng", "carry", "hold", "cầm", "giữ", "vác", "mang" }
                        for i = 1, #kw do
                            if string_find(t, kw[i], 1, true) then CarrySrc = "label"; found = true; return end
                        end
                    end
                end
            end
        end, 6)
        if found then return true end
    end
    if Char then
        local children = Char:GetChildren()
        for i = 1, #children do
            local c = children[i]
            local n = string_lower(c.Name)
            if (string_find(n, "egg", 1, true) or string_find(n, "trứng", 1, true))
                and not string_find(n, "bat", 1, true) and not string_find(n, "gậy", 1, true)
                and (c:IsA("BasePart") or c:IsA("Model") or c:IsA("MeshPart")) then
                CarrySrc = "model: " .. c.Name
                return true
            end
        end
    end
    CarrySrc = ""
    return false
end

local function SetStealState(s)
    State.StealState = s
    Log(LOG_LEVEL.DEBUG, "StealState=" .. s)
end

local function TrySteal(prompt, pos)
    if not prompt or not HRP then return false end
    local maxD = (prompt.MaxActivationDistance or 10)
    for attempt = 1, 3 do
        if not prompt.Parent or not prompt.Enabled then SetStealState("success"); return true end
        if IsCarrying() then SetStealState("success"); return true end
        SetStealState("approach")
        if (HRP.Position - pos).Magnitude > maxD then
            if not State.KickShield and (State.StealMode == "tele" or State.StealMode == "instant") then
                TeleTo(pos, 6, true)
            else
                WalkTo(pos, 6)
            end
            task_wait(0.2)
        end
        ThrottleRemote()
        local fired = false
        if State.StealMode == "instant" and not State.KickShield then
            fired = pcall(function()
                if fireproximityprompt then fireproximityprompt(prompt) else error("no-fpp") end
            end)
        end
        SetStealState("hold")
        local okB = pcall(function() prompt:InputHoldBegin() end)
        if okB then
            local raw = prompt.HoldDuration or 0
            local hold = fired and 0.05 or math_clamp(raw, 0.1, 3)
            local t0 = os_clock()
            local result = nil
            while os_clock() - t0 < hold do
                task_wait(0.08)
                if not prompt.Parent or not prompt.Enabled then result = "taken"; break end
                if not HRP then result = "dead"; break end
                if IsCarrying() then result = "carry"; break end
            end
            pcall(function() prompt:InputHoldEnd() end)
            if result == "taken" or result == "carry" then SetStealState("success"); return true end
            if result == "dead" then SetStealState("failed"); return false end
            task_wait(0.15)
            if IsCarrying() then SetStealState("success"); return true end
            if not prompt.Parent or not prompt.Enabled then SetStealState("success"); return true end
            SetStealState("verify")
            ThrottleRemote()
            pcall(function() prompt:InputHoldBegin() end)
            task_wait(0.12)
            pcall(function() prompt:InputHoldEnd() end)
            task_wait(0.15)
            if IsCarrying() then SetStealState("success"); return true end
            if not prompt.Parent or not prompt.Enabled then SetStealState("success"); return true end
        end
        task_wait(0.25)
    end
    SetStealState("failed")
    return IsCarrying()
end

local function PlayerNearby(d)
