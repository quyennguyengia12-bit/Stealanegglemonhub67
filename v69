local function ScanZones()
    State.ZoneCache = {}
    pcall(function()
        forEachDescendantIterative(Workspace, function(o)
            local txt = nil
            if o:IsA("TextLabel") then
                txt = o.Text
            elseif o:IsA("BillboardGui") then
                local tl = o:FindFirstChildOfClass("TextLabel")
                if tl then txt = tl.Text end
            end
            if txt then
                local lt = string_lower(txt)
                for _, zn in ipairs(ZONE_NAMES) do
                    if string_find(lt, string_lower(zn), 1, true) and not State.ZoneCache[zn] then
                        local pos = nil
                        if o:IsA("BillboardGui") and o.Adornee and o.Adornee:IsA("BasePart") then
                            pos = o.Adornee.Position
                        else
                            local p = o
                            for i = 1, 4 do
                                p = p.Parent
                                if not p then break end
                                if p:IsA("BasePart") then pos = p.Position; break end
                            end
                        end
                        if pos then State.ZoneCache[zn] = pos end
                    end
                end
            end
        end, 6)
    end)
end

local function CountZones()
    local n = 0
    for _ in pairs(State.ZoneCache) do n = n + 1 end
    return n
end

local function TeleportToZone(zn)
    if CountZones() == 0 then ScanZones() end
    local pos = State.ZoneCache[zn]
    if not pos then
        NotifyRef("warn", "🗺 KHÔNG THẤY ZONE", "Chưa quét thấy " .. zn, 2)
        return
    end
    local ok = TeleTo(pos, nil, true)
    NotifyRef(ok and "success" or "warn", ok and ("🗺 ĐẾN " .. zn) or "🗺 TELE HỤT", ok and ("Đã tới " .. zn) or ("Không tới được " .. zn), 2)
end

