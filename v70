local BACKOFF = { 0.5, 1, 1.5, 2.5, 4 }
local function RobustReturnToNest(tp, ma)
    ma = ma or 5
    for a = 1, ma do
        if State.FarmMode == "off" then return false end
        if not IsCarrying() then return true end
        if not HRP or not Hum or Hum.Health <= 0 then return false end
        if (HRP.Position - tp).Magnitude < 12 then return true end
        local d = (HRP.Position - tp).Magnitude
        local dt = math_max(30, d / math_max(16, State.FarmSpeed) * 2.5)
        local ok = SmartMove(tp, dt)
        if ok and HRP and (HRP.Position - tp).Magnitude < 12 then return true end
        SetStatus(string_format("🔄 #%d/%d", a, ma)); task_wait(BACKOFF[a] or 4); MaybeScan(true)
    end
    return false
end
