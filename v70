-- ==============================================================================
local function forEachDescendantIterative(root, callback, maxDepth)
    maxDepth = maxDepth or 12
    local queue = {{root, 0}}
    local head = 1
    local count = 0
    while head <= #queue do
        local item = queue[head]
        head = head + 1
        count = count + 1
        if count % 1500 == 0 then task_wait() end
        local node, d = item[1], item[2]
        pcall(callback, node)
        if d < maxDepth then
            local ch = node:GetChildren()
            for i = 1, #ch do queue[#queue + 1] = {ch[i], d + 1} end
        end
        if head > 4000 then
            local s = head - 1
            local L = #queue
            local nq = {}
            for i = s + 1, L do nq[i - s] = queue[i]; queue[i] = nil end
            queue = nq
            head = 1
        end
    end
end

