end
local function SetStealState(s) State.StealState = s; Log(LOG_LEVEL.DEBUG, "StealState=" .. s) end
local function TrySteal(prompt, pos)
    if not prompt or not HRP then return false end
    local maxD = (prompt.MaxActivationDistance or 10)
    for a = 1, 3 do
        if not prompt.Parent or not prompt.Enabled then SetStealState("success"); return true end
        if IsCarrying() then SetStealState("success"); return true end
        SetStealState("approach")
        if (HRP.Position - pos).Magnitude > maxD then
            if not State.KickShield and (State.StealMode == "tele" or State.StealMode == "instant") then TeleTo(pos, 6, true) else WalkTo(pos, 6) end
            task_wait(0.2)
        end
        ThrottleRemote()
        local fired = false
        if State.StealMode == "instant" and not State.KickShield then fired = pcall(function() if fireproximityprompt then fireproximityprompt(prompt) else error("no") end end) end
        SetStealState("hold")
        local okB = pcall(function() prompt:InputHoldBegin() end)
        if okB then
            local raw = prompt.HoldDuration or 0
            local hold = fired and 0.05 or math_clamp(raw, 0.1, 3)
            local t0 = os_clock(); local res = nil
            while os_clock() - t0 < hold do
                task_wait(0.08)
                if not prompt.Parent or not prompt.Enabled then res = "taken"; break end
                if not HRP then res = "dead"; break end
                if IsCarrying() then res = "carry"; break end
            end
            pcall(function() prompt:InputHoldEnd() end)
            if res == "taken" or res == "carry" then SetStealState("success"); return true end
            if res == "dead" then SetStealState("failed"); return false end
            task_wait(0.15)
            if IsCarrying() then SetStealState("success"); return true end
            if not prompt.Parent or not prompt.Enabled then SetStealState("success"); return true end
            SetStealState("verify"); ThrottleRemote()
            pcall(function() prompt:InputHoldBegin() end); task_wait(0.12); pcall(function() prompt:InputHoldEnd() end); task_wait(0.15)
            if IsCarrying() then SetStealState("success"); return true end
            if not prompt.Parent or not prompt.Enabled then SetStealState("success"); return true end
        end
        task_wait(0.25)
    end
    SetStealState("failed"); return IsCarrying()
end
local function PlayerNearby(d)
    local ps = Players:GetPlayers()
    for i = 1, #ps do local pl = ps[i]; if pl ~= LocalPlayer and pl.Character then local h = pl.Character:FindFirstChild("HumanoidRootPart"); if h and HRP and (h.Position - HRP.Position).Magnitude < d then return true end end end
