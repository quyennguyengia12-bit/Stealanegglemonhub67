                if string_find(t, "chạy!!", 1, true) then CarrySrc = "banner"; found = true; return end
                if g.AbsoluteSize.Y > 5 and g.AbsoluteSize.Y < 150 then
                    local bl = false
                    for i = 1, #CARRY_BL do if string_find(t, CARRY_BL[i], 1, true) then bl = true; break end end
                    if not bl then
                        local kw = { "thả trứng", "drop egg", "đặt trứng", "deliver egg", "giao trứng", "carry", "hold", "cầm", "giữ", "vác", "mang" }
                        for i = 1, #kw do if string_find(t, kw[i], 1, true) then CarrySrc = "label"; found = true; return end end
                    end
                end
            end
        end, 6)
        if found then return true end
    end
    if Char then
