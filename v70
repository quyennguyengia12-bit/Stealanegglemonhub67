local function LoadConfig()
    if not HAS_FILE_API then NotifyRef("warn", "📂 CONFIG", "Executor không hỗ trợ file!", 3); return end
    local ok, data = pcall(function() return isfile(CONFIG_FILE) and readfile(CONFIG_FILE) or nil end)
    if not ok or not data then NotifyRef("warn", "📂 CONFIG", "Chưa có config!", 3); return end
    for line in string_gmatch(data, "[^\n]+") do
        local k, v = string_match(line, "^([^=]+)=(.*)$")
        if k and v then
            k = string_gsub(k, "%s+$", ""); v = string_gsub(v, "%s+$", "")
            if k == "FarmSpeed" then State.FarmSpeed = math_clamp(tonumber(v) or 16, WALK_SPEED_MIN, WALK_SPEED_MAX)
            elseif k == "Radius" then State.Radius = math_clamp(tonumber(v) or 2500, 500, 3000)
            elseif k == "TeleSpeed" then State.TeleSpeed = math_clamp(tonumber(v) or 50, TELE_SPEED_MIN, TELE_SPEED_MAX)
            elseif k == "CycleHigh" then State.CycleHigh = math_clamp(tonumber(v) or 25, 5, 60)
            elseif k == "CycleSafe" then State.CycleSafe = math_clamp(tonumber(v) or 8, 3, 30)
            elseif k == "SpeedPulse" then State.SpeedPulse = (v == "true")
            elseif k == "SpeedCycle" then State.SpeedCycle = (v == "true")
            elseif k == "Ghost" then State.Ghost = (v == "true")
            elseif k == "AutoFlee" then State.AutoFlee = (v == "true")
            elseif k == "EspEggs" then State.EspEggs = (v == "true")
            elseif k == "EspPlayers" then State.EspPlayers = (v == "true")
            elseif k == "ShowNotify" then State.ShowNotify = (v == "true")
            elseif k == "ShowStatus" then State.ShowStatus = (v == "true")
            elseif k == "BlurOn" then State.BlurOn = (v == "true")
            elseif k == "UseInstantZone" then State.UseInstantZone = (v == "true")
            elseif k == "StealMode" then State.StealMode = v
            end
        end
    end
    ApplySpeedNow()
    NotifyRef("success", "📂 ĐÃ TẢI", "Config đã áp dụng!", 3)
end

